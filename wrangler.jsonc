{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-worker",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "ALLOWED_TARGETS": "wss://eagler.carrot-craft.org/",
    "NEW_SESSION_CUTOFF": "60000",
    "GUST_WISP_URL": "wss://wisp.mercurywork.shop/"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "RelayHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RelayHub"
      ]
    }
  ]
}
